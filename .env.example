GROQ_API_KEY=your_groq_api_key_here

# Shared secret between your app and this service.
# Leave empty for local dev; always set it in production.
API_KEY=your_random_secret_here

# Clip sources - Pexels primary, Pixabay fallback.
# Wikimedia Commons is the last fallback and needs no key.
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabaya_api_key_here

# SQLite - auto-created, zero setup
# DB_PATH=data/creatoragent.db

# Cloudflare R2 - finished videos live here
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_bucket_name
# Optional: public bucket or custom domain gives permanent URLs.
# If unset, the API returns presigned links (capped at 7 days by SigV4).
R2_PUBLIC_BASE_URL=
# How long a finished video stays in R2 before the lifecycle rule deletes it.
# Run `python setup_r2.py` after changing this.
R2_RETENTION_DAYS=7
