GROQ_API_KEY=your_groq_api_key_here
PEXELS_API_KEY=your_pexels_api_key_here

# Vayug App Publishing (snehayog.site)
# Google OAuth - Browser auto-open hoga sign-in ke liye
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
# JWT aur Refresh Token automatically store hoga sign-in ke baad
VAYUG_JWT=your_jwt_here
VAYUG_REFRESH_TOKEN=your_refresh_token_here
VAYUG_API_BASE=https://api.snehayog.site

# YouTube Settings (optional - defaults are set in config.py)
# YOUTUBE_MAX_FILESIZE=30
# YOUTUBE_CLIP_DURATION=3
